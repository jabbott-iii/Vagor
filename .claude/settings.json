{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(./gradlew assembleDebug)",
      "Bash(./gradlew assembleDebug *)",
      "Bash(./gradlew assembleDebugAndroidTest)",
      "Bash(./gradlew assembleDebugAndroidTest *)",
      "Bash(./gradlew testDebugUnitTest)",
      "Bash(./gradlew testDebugUnitTest *)",
      "Bash(./gradlew lint)",
      "Bash(./gradlew lint *)",
      "Bash(./gradlew detekt)",
      "Bash(./gradlew detekt *)",
      "Bash(./gradlew ktlintCheck)",
      "Bash(./gradlew ktlintCheck *)",
      "Bash(./gradlew ktlintFormat)",
      "Bash(./gradlew ktlintFormat *)",
      "Bash(./gradlew bundleRelease)",
      "Bash(./gradlew bundleRelease *)",
      "Bash(./gradlew tasks)",
      "Bash(./gradlew tasks *)",
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff)",
      "Bash(git diff *)",
      "Bash(git log)",
      "Bash(git log *)",
      "Bash(git show)",
      "Bash(git show *)",
      "Bash(git blame *)"
    ],
    "ask": [
      "Bash(./gradlew connectedDebugAndroidTest)",
      "Bash(./gradlew connectedDebugAndroidTest *)",
      "Bash(./gradlew connectedAndroidTest)",
      "Bash(./gradlew connectedAndroidTest *)",
      "Bash(./gradlew * connected*)",
      "Bash(./gradlew install*)",
      "Bash(./gradlew * install*)",
      "Bash(./gradlew uninstall*)",
      "Bash(./gradlew * uninstall*)",
      "Bash(./gradlew --no-configuration-cache *)",
      "Bash(./gradlew * --no-configuration-cache*)",
      "Bash(ANDROID_SERIAL=*)",
      "Bash(adb install *)",
      "Bash(adb * install *)",
      "Bash(adb uninstall *)",
      "Bash(adb * uninstall *)",
      "Bash(adb shell)",
      "Bash(adb shell *)",
      "Bash(adb * shell *)",
      "Bash(adb exec-out *)",
      "Bash(adb * exec-out *)"
    ],
    "deny": [
      "Bash(git commit)",
      "Bash(git commit *)",
      "Bash(git push)",
      "Bash(git push *)",
      "Bash(git rebase)",
      "Bash(git rebase *)",
      "Bash(git merge *)",
      "Bash(git tag *)",
      "Bash(git cherry-pick *)",
      "Bash(git am *)",
      "Bash(git reset --hard)",
      "Bash(git reset --hard *)",
      "Bash(git filter-branch *)",
      "Bash(git filter-repo *)",
      "Bash(make -f Makefile.txt tag*)",
      "Bash(make -f Makefile.txt push-tag*)",
      "Bash(make -f Makefile.txt release*)",
      "Bash(make * tag*)",
      "Bash(make * push-tag*)",
      "Bash(make * release*)",
      "Bash(adb -d)",
      "Bash(adb -d *)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(**/*.jks)",
      "Read(**/*.keystore)",
      "Read(**/*.p12)",
      "Read(**/*.pfx)",
      "Read(~/keys/**)"
    ]
  }
}
