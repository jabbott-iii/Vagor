<?xml version="1.0" encoding="utf-8"?>
<!-- Scrolls so every field and button stays reachable in landscape and on small screens. -->
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Add or edit, set in code, like the screen's title. -->
        <TextView
            android:id="@+id/eventFormHeading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:accessibilityHeading="true"
            android:textSize="24sp"
            android:layout_marginBottom="16dp"
            tools:targetApi="28"
            tools:text="@string/add_event" />

        <EditText
            android:id="@+id/editEventTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="57dp"
            android:importantForAutofill="no"
            android:hint="@string/event_title"
            android:inputType="text" />

        <EditText
            android:id="@+id/editEventDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="57dp"
            android:layout_marginTop="8dp"
            android:importantForAutofill="no"
            android:drawableEnd="@drawable/ic_calendar"
            android:hint="@string/event_date"
            android:inputType="date" />

        <!-- Filled from a clock (MaterialTimePicker) and shown in the phone's 12- or 24-hour
             style; EventDetailActivity keeps the picked time. -->
        <EditText
            android:id="@+id/editEventTime"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="57dp"
            android:layout_marginTop="8dp"
            android:importantForAutofill="no"
            android:drawableEnd="@drawable/ic_schedule"
            android:hint="@string/event_time"
            android:inputType="time" />

        <!-- Filled from the time zone list (TimeZonePickerDialog); starts on the phone's zone. -->
        <EditText
            android:id="@+id/editEventTimeZone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="57dp"
            android:layout_marginTop="8dp"
            android:importantForAutofill="no"
            android:drawableEnd="@drawable/ic_public"
            android:hint="@string/event_time_zone"
            android:inputType="text" />

        <!-- Optional, and grows with each line typed. -->
        <EditText
            android:id="@+id/editEventDetails"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="57dp"
            android:layout_marginTop="8dp"
            android:importantForAutofill="no"
            android:gravity="top|start"
            android:hint="@string/event_details_hint"
            android:inputType="textMultiLine|textCapSentences" />

        <Button
            android:id="@+id/buttonSaveEvent"
            style="@style/Widget.Vagor.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/save_event" />

        <Button
            android:id="@+id/buttonDeleteEvent"
            style="@style/Widget.Vagor.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/button_spacing"
            android:text="@string/delete_event" />

        <Button
            android:id="@+id/buttonShareEvent"
            style="@style/Widget.Vagor.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/button_spacing"
            android:text="@string/share_event" />

        <Button
            android:id="@+id/buttonEventToCalendar"
            style="@style/Widget.Vagor.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/button_spacing"
            android:text="@string/add_to_calendar" />

    </LinearLayout>

</ScrollView>
