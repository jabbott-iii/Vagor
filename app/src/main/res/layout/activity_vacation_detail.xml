<?xml version="1.0" encoding="utf-8"?>
<!-- Scrolls so every field and button stays reachable in landscape and on small screens. -->
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/vacation_details"
            android:textSize="24sp"
            android:layout_marginBottom="8dp"/>

        <EditText
            android:id="@+id/editTitle"
            android:layout_width="match_parent"
            android:layout_height="57dp"
            android:autofillHints="none"
            android:hint="@string/vacation_title"
            android:inputType="text" />

        <!-- Optional, and grows with each line typed. -->
        <EditText
            android:id="@+id/editTripDetails"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="57dp"
            android:layout_marginTop="8dp"
            android:autofillHints="none"
            android:gravity="top|start"
            android:hint="@string/trip_details"
            android:inputType="textMultiLine|textCapSentences" />

        <EditText
            android:id="@+id/editStartDate"
            android:layout_width="match_parent"
            android:layout_height="57dp"
            android:layout_marginTop="8dp"
            android:autofillHints="none"
            android:drawableEnd="@drawable/ic_calendar"
            android:hint="@string/start_date"
            android:inputType="date" />

        <EditText
            android:id="@+id/editEndDate"
            android:layout_width="match_parent"
            android:layout_height="57dp"
            android:layout_marginTop="8dp"
            android:autofillHints="none"
            android:drawableEnd="@drawable/ic_calendar"
            android:hint="@string/end_date"
            android:inputType="date" />

        <Button
            android:id="@+id/buttonSave"
            style="@style/Widget.Vagor.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/save" />

        <Button
            android:id="@+id/buttonDelete"
            style="@style/Widget.Vagor.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/button_spacing"
            android:text="@string/delete" />

    </LinearLayout>

</ScrollView>
