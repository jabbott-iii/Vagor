<?xml version="1.0" encoding="utf-8"?>
<!-- Scrolls so every field and button stays reachable in landscape and on small screens. -->
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Add or edit, set in code, like the screen's title. -->
        <TextView
            android:id="@+id/vacationFormHeading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:accessibilityHeading="true"
            android:textSize="24sp"
            android:layout_marginBottom="8dp"
            tools:targetApi="28"
            tools:text="@string/add_vacation" />

        <EditText
            android:id="@+id/editTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="57dp"
            android:importantForAutofill="no"
            android:hint="@string/vacation_title"
            android:inputType="text" />

        <!-- Optional, and grows with each line typed. -->
        <EditText
            android:id="@+id/editTripDetails"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="57dp"
            android:layout_marginTop="8dp"
            android:importantForAutofill="no"
            android:gravity="top|start"
            android:hint="@string/trip_details"
            android:inputType="textMultiLine|textCapSentences" />

        <com.example.vagor.DateField
            android:id="@+id/editStartDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="57dp"
            android:layout_marginTop="8dp"
            android:importantForAutofill="no"
            android:drawableEnd="@drawable/ic_calendar"
            android:hint="@string/start_date"
            android:inputType="date" />

        <com.example.vagor.DateField
            android:id="@+id/editEndDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="57dp"
            android:layout_marginTop="8dp"
            android:importantForAutofill="no"
            android:drawableEnd="@drawable/ic_calendar"
            android:hint="@string/end_date"
            android:inputType="date" />

        <Button
            android:id="@+id/buttonSave"
            style="@style/Widget.Vagor.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/save" />

        <Button
            android:id="@+id/buttonDelete"
            style="@style/Widget.Vagor.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/button_spacing"
            android:text="@string/delete" />

    </LinearLayout>

</ScrollView>
