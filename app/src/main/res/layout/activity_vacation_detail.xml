<?xml version="1.0" encoding="utf-8"?>
<!-- Scrolls so every field and button stays reachable in landscape and on small screens. -->
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/vacation_details"
            android:textSize="24sp"
            android:layout_marginBottom="8dp"/>

        <EditText
            android:id="@+id/editTitle"
            android:layout_width="match_parent"
            android:layout_height="57dp"
            android:autofillHints="none"
            android:hint="@string/vacation_title"
            android:inputType="text" />

        <EditText
            android:id="@+id/editHotel"
            android:layout_width="match_parent"
            android:layout_height="57dp"
            android:layout_marginTop="8dp"
            android:autofillHints="none"
            android:hint="@string/hotel"
            android:inputType="text" />

        <EditText
            android:id="@+id/editStartDate"
            android:layout_width="match_parent"
            android:layout_height="57dp"
            android:layout_marginTop="8dp"
            android:autofillHints="none"
            android:drawableEnd="@drawable/ic_calendar"
            android:hint="@string/start_date"
            android:inputType="date" />

        <EditText
            android:id="@+id/editEndDate"
            android:layout_width="match_parent"
            android:layout_height="57dp"
            android:layout_marginTop="8dp"
            android:autofillHints="none"
            android:drawableEnd="@drawable/ic_calendar"
            android:hint="@string/end_date"
            android:inputType="date" />

        <Button
            android:id="@+id/buttonSave"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="89dp"
            android:layout_marginTop="16dp"
            android:text="@string/save" />

        <Button
            android:id="@+id/buttonDelete"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="102dp"
            android:layout_marginTop="8dp"
            android:text="@string/delete" />

    </LinearLayout>

</ScrollView>
