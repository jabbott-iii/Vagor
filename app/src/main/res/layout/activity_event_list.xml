<?xml version="1.0" encoding="utf-8"?>
<!-- A vacation's page: its details, Edit and Share buttons, and its events. One scrolling page
     (rather than a list with a header) so keyboard and D-pad focus follow the screen's order. -->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- An id so its scroll position survives rotation. -->
    <ScrollView
        android:id="@+id/vacationPageScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- The bottom padding lets the last event scroll clear of the Add Event button. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="@dimen/add_button_clearance">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/vacationPageTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:accessibilityHeading="true"
                    android:textAppearance="?attr/textAppearanceHeadlineSmall"
                    tools:targetApi="28" />

                <TextView
                    android:id="@+id/vacationPageDates"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textAppearance="?attr/textAppearanceBodyLarge" />

                <TextView
                    android:id="@+id/vacationPageHotel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:textColor="?attr/colorOnSurfaceVariant" />

                <Button
                    android:id="@+id/buttonEditVacation"
                    style="@style/Widget.Vagor.Button.Outlined"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/edit_vacation" />

                <Button
                    android:id="@+id/buttonShareVacation"
                    style="@style/Widget.Vagor.Button.Outlined"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/button_spacing"
                    android:text="@string/share_vacation" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:accessibilityHeading="true"
                    android:text="@string/events"
                    android:textAppearance="?attr/textAppearanceTitleMedium"
                    tools:targetApi="28" />

                <TextView
                    android:id="@+id/emptyEvents"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/no_events_yet"
                    android:textAppearance="?attr/textAppearanceBodyLarge"
                    android:visibility="gone" />

            </LinearLayout>

            <!-- One item_event row per event, in date order (EventListActivity). -->
            <LinearLayout
                android:id="@+id/eventRows"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

        </LinearLayout>

    </ScrollView>

    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/buttonAddEvent"
        style="@style/Widget.Vagor.AddButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="16dp"
        android:text="@string/add_event" />

</FrameLayout>
