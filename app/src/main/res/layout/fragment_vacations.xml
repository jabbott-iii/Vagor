<?xml version="1.0" encoding="utf-8"?>
<!-- The dashboard: every vacation with its dates, soonest first (see Dashboard.rows). -->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="8dp"
            android:accessibilityHeading="true"
            android:text="@string/vacations"
            android:textAppearance="?attr/textAppearanceHeadlineSmall"
            tools:targetApi="28" />

        <!-- The bottom padding lets the last card scroll clear of the Add Vacation button. -->
        <ListView
            android:id="@+id/vacationListView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:divider="@null"
            android:dividerHeight="0dp"
            android:drawSelectorOnTop="true"
            android:listSelector="@drawable/dashboard_focus_selector"
            android:paddingBottom="88dp" />

        <TextView
            android:id="@+id/emptyVacations"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp"
            android:text="@string/no_vacations_yet"
            android:textAppearance="?attr/textAppearanceBodyLarge"
            android:visibility="gone" />

    </LinearLayout>

    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/buttonAddVacation"
        style="@style/Widget.Vagor.AddButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="16dp"
        android:text="@string/add_vacation" />

</FrameLayout>
