<?xml version="1.0" encoding="utf-8"?>
<!-- Shown under the vacation's details when it has no events. A ListView footer can't be hidden
     itself, so EventListActivity hides the text inside it. -->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <TextView
        android:id="@+id/emptyEvents"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="16dp"
        android:text="@string/no_events_yet"
        android:textAppearance="?attr/textAppearanceBodyLarge" />

</FrameLayout>
