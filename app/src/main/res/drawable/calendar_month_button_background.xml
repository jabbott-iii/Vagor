<?xml version="1.0" encoding="utf-8"?>
<!-- The previous and next month buttons: a round ripple, and a round ring when they have keyboard
     focus. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/calendar_ripple">
    <item
        android:id="@android:id/mask"
        android:width="40dp"
        android:height="40dp"
        android:gravity="center">
        <shape android:shape="oval">
            <solid android:color="@android:color/white" />
        </shape>
    </item>
    <item>
        <selector>
            <item android:state_focused="true">
                <layer-list>
                    <item
                        android:width="44dp"
                        android:height="44dp"
                        android:gravity="center">
                        <shape android:shape="oval">
                            <stroke
                                android:width="2dp"
                                android:color="?attr/colorOnSurface" />
                        </shape>
                    </item>
                </layer-list>
            </item>
        </selector>
    </item>
</ripple>
