<?xml version="1.0" encoding="utf-8"?>
<!-- Shows which card has keyboard or D-pad focus; touches get the card's own ripple. The ring's
     offsets match item_vacation.xml's padding and the filled card's 12dp corners. It's a layer-list
     because an <inset> would also pad every row of the list. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true" android:state_pressed="false">
        <layer-list>
            <item
                android:bottom="4dp"
                android:left="16dp"
                android:right="16dp"
                android:top="4dp">
                <shape android:shape="rectangle">
                    <corners android:radius="12dp" />
                    <stroke
                        android:width="3dp"
                        android:color="?attr/colorPrimary" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item android:drawable="@android:color/transparent" />
</selector>
