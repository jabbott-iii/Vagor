<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. Light blue scheme; values-night holds the dark one. -->
    <style name="Base.Theme.Vagor" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/vagor_light_primary</item>
        <item name="colorOnPrimary">@color/vagor_light_onPrimary</item>
        <item name="colorPrimaryContainer">@color/vagor_light_primaryContainer</item>
        <item name="colorOnPrimaryContainer">@color/vagor_light_onPrimaryContainer</item>
        <item name="colorSecondary">@color/vagor_light_secondary</item>
        <item name="colorOnSecondary">@color/vagor_light_onSecondary</item>
        <item name="colorSecondaryContainer">@color/vagor_light_secondaryContainer</item>
        <item name="colorOnSecondaryContainer">@color/vagor_light_onSecondaryContainer</item>
        <item name="colorTertiary">@color/vagor_light_tertiary</item>
        <item name="colorOnTertiary">@color/vagor_light_onTertiary</item>
        <item name="colorTertiaryContainer">@color/vagor_light_tertiaryContainer</item>
        <item name="colorOnTertiaryContainer">@color/vagor_light_onTertiaryContainer</item>
        <item name="colorError">@color/vagor_light_error</item>
        <item name="colorOnError">@color/vagor_light_onError</item>
        <item name="colorErrorContainer">@color/vagor_light_errorContainer</item>
        <item name="colorOnErrorContainer">@color/vagor_light_onErrorContainer</item>
        <item name="android:colorBackground">@color/vagor_light_background</item>
        <item name="colorOnBackground">@color/vagor_light_onBackground</item>
        <item name="colorSurface">@color/vagor_light_surface</item>
        <item name="colorOnSurface">@color/vagor_light_onSurface</item>
        <item name="colorSurfaceVariant">@color/vagor_light_surfaceVariant</item>
        <item name="colorOnSurfaceVariant">@color/vagor_light_onSurfaceVariant</item>
        <item name="colorOutline">@color/vagor_light_outline</item>
        <item name="colorOutlineVariant">@color/vagor_light_outlineVariant</item>
        <item name="colorSurfaceInverse">@color/vagor_light_inverseSurface</item>
        <item name="colorOnSurfaceInverse">@color/vagor_light_inverseOnSurface</item>
        <item name="colorPrimaryInverse">@color/vagor_light_inversePrimary</item>
        <item name="colorSurfaceDim">@color/vagor_light_surfaceDim</item>
        <item name="colorSurfaceBright">@color/vagor_light_surfaceBright</item>
        <item name="colorSurfaceContainerLowest">@color/vagor_light_surfaceContainerLowest</item>
        <item name="colorSurfaceContainerLow">@color/vagor_light_surfaceContainerLow</item>
        <item name="colorSurfaceContainer">@color/vagor_light_surfaceContainer</item>
        <item name="colorSurfaceContainerHigh">@color/vagor_light_surfaceContainerHigh</item>
        <item name="colorSurfaceContainerHighest">@color/vagor_light_surfaceContainerHighest</item>
        <!-- Material 3's default text and control colours are fixed neutrals; use this scheme's. -->
        <item name="android:textColorPrimary">@color/vagor_light_onSurface</item>
        <item name="android:textColorSecondary">@color/vagor_light_onSurfaceVariant</item>
        <item name="android:textColorTertiary">@color/vagor_light_onSurfaceVariant</item>
        <item name="android:textColorHint">@color/vagor_light_onSurfaceVariant</item>
        <item name="android:textColorHighlight">@color/vagor_light_primaryContainer</item>
        <item name="colorControlNormal">@color/vagor_light_onSurfaceVariant</item>
        <item name="colorControlActivated">@color/vagor_light_primary</item>
    </style>

    <style name="Theme.Vagor" parent="Base.Theme.Vagor" />
</resources>